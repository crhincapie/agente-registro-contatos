# Modelo de lenguaje (servidor)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# Base de datos (servidor, nunca en el navegador)
SUPABASE_URL=
# Clave secreta actual (formato sb_secret_...). Tiene prioridad sobre SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# Compatibilidad: clave service_role heredada, solo si no existe SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Fecha de referencia para alertas (AAAA-MM-DD), opcional
FECHA_REFERENCIA=
